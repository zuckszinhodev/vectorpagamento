APP_NAME="Vector Pagamentos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db.<your-project-ref>.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require
DB_PERSISTENT=true
DB_SEARCH_PATH=public
DB_STATEMENT_CACHE_SIZE=100

# Optional: use Supabase pooler or direct URI instead of host/port variables above.
# DATABASE_URL=postgresql://postgres:<password>@db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Production hardening
# APP_DEBUG=false
# SESSION_DRIVER=database
# SESSION_EXPIRE_ON_CLOSE=true
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=strict
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# CORS_ALLOW_ALL_ORIGINS=false
# CORS_ALLOW_VECTOR_WILDCARD=true

# Gere com: php artisan jwt:secret --force
# Precisa ficar antes de SUPABASE_JWT_SECRET: o comando grava na primeira linha
# que contém "JWT_SECRET" e, sem esta, sobrescreve a do Supabase.
JWT_SECRET=

SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail. Local: MAIL_MAILER=log (só grava em storage/logs).
# Produção com Resend via SMTP: domínio verificado em resend.com > Domains,
# MAIL_PASSWORD = API key (re_...) com "Sending access".
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=465
# MAIL_USERNAME=resend
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@seu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare Turnstile (anti-bot no login). Vazio = verificação desligada.
TURNSTILE_SECRET_KEY=
GOOGLE_REDIRECT_URI=

# ─────────────────────────────────────────────────────────────
# Roteamento de adquirentes
# ─────────────────────────────────────────────────────────────

# Cofre de credenciais (AES-256-GCM).
# Gere com: php artisan acquirer:generate-key
# Sem esta chave, o cofre deriva uma do APP_KEY e registra um aviso.
# IMPORTANTE: faça backup — sem ela as credenciais gravadas são irrecuperáveis.
ACQUIRER_ENCRYPTION_KEY=
ACQUIRER_ENCRYPTION_KEY_VERSION=1
# Chaves antigas mantidas para leitura durante rotação, ex.: {"1":"<base64>"}
ACQUIRER_ENCRYPTION_KEYS_PREVIOUS=

# Motor de roteamento inteligente. Desligue para voltar ao caminho legado
# sem deploy. rollout_percentage permite liberar gradualmente (canary).
ACQUIRER_ROUTING_ENGINE_ENABLED=true
ACQUIRER_ROUTING_ROLLOUT_PERCENTAGE=100

# Estratégia padrão: priority | round_robin | weighted
#                  | least_latency | best_approval | least_utilization
ACQUIRER_ROUTING_STRATEGY=priority
ACQUIRER_FAILOVER_ENABLED=true
ACQUIRER_ROUTING_MAX_ATTEMPTS=3
ACQUIRER_ROUTING_BUDGET_MS=25000
ACQUIRER_ROUTING_STRICT_HEALTH=true

# Health check
ACQUIRER_HEALTH_CHECK_ENABLED=true
ACQUIRER_HEALTH_CHECK_INTERVAL=60
ACQUIRER_HEALTH_DEGRADED_LATENCY_MS=3000
ACQUIRER_HEALTH_OFFLINE_AFTER=2

# Pool de conexões HTTP
ACQUIRER_HTTP_POOLING=true
ACQUIRER_HTTP_MAX_CONNECTIONS=50
ACQUIRER_HTTP_MAX_PER_HOST=20

# Retenção da telemetria (dias)
ACQUIRER_METRICS_RETENTION_DAYS=30
ACQUIRER_ROUTING_LOGS_RETENTION_DAYS=60
ACQUIRER_EVENTS_RETENTION_DAYS=90
