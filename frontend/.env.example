# API Configuration
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Supabase Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# App Configuration
VITE_APP_NAME=Vector Pagamentos
VITE_APP_URL=http://localhost:5173

# Google OAuth
# Get Client ID at: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Tema usado antes de /branding responder (classic | modern). Use o mesmo do painel admin
# para a tela não abrir clara e depois escurecer.
VITE_DEFAULT_THEME_VARIANT=classic

# Cloudflare Turnstile (anti-bot no login). Vazio = widget desligado.
VITE_TURNSTILE_SITE_KEY=

# Realtime / WebSocket (optional)
# Leave empty to disable browser realtime safely in production.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=
VITE_PUSHER_SCHEME=
